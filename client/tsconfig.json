{
    "compilerOptions": {
        "module": "esnext",
        "target": "es2015",
        "sourceMap": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "isolatedModules": true,
        "noImplicitAny": true,
        "noUnusedLocals": true,
        "outDir": "./dist/",
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "strict": false,
        "types": ["vite/client"],
        "lib": ["es2020", "dom"],
        "rootDir": "./src"
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.test.tsx"]
}
