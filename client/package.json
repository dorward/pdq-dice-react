		"axios": "^1.7.8",
		"classnames": "^2.5.1",
		"components": "^0.1.0",
		"js-yaml": "^5.5.0",
		"normalize.css": "^8.0.1",
		"react": "^19.3.1",
		"react-avatar-editor": "^16.0.0",
		"react-dom": "^19.3.1",
		"react-dropzone": "^20.1.4",
		"react-markdown": "^10.1.0",
