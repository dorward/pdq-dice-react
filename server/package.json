{
	"name": "pdq-dice-react-api",
	"version": "4.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"build": "tsc",
		"start:production": "tsc && node dist/app.js",
		"start:development": "nodemon ./src/app.ts",
		"typecheck": "tsc --noEmit",
		"typecheck:watch": "tsc --noEmit --watch",
		"lint": "oxlint .",
		"format:check": "oxfmt --check src test",
		"format:fix": "oxfmt --write src test",
		"lint:fix": "oxlint --fix .",
		"test:integration": "vitest run --config vitest.integration.config.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:typecheck": "tsc --noEmit -p tsconfig.test.json"
	},
	"keywords": [],
	"author": "David Dorward <david@dorward.me.uk>",
	"license": "ISC",
	"devDependencies": {
		"@types/cors": "^2.8.17",
		"@types/express": "^5.0.6",
		"@types/indefinite": "^2.3.4",
		"@types/node": "^26.6.5",
		"@types/pg": "^8.11.0",
		"nodemon": "^3.0.3",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@discordjs/rest": "^2.2.0",
		"@types/uuid": "^10.0.0",
		"ascii-table3": "^1.0.4",
		"cors": "^2.8.5",
		"discord-api-types": "^0.38.56",
		"discord.js": "^14.14.1",
		"express": "^5.3.0",
		"express-rate-limit": "^8.7.1",
		"indefinite": "^2.5.1",
		"pg": "^8.11.3",
		"sharp": "^0.35.5",
		"uuid": "^14.0.3",
		"xmlbuilder2": "^4.0.3"
	},
	"packageManager": "pnpm@12.6.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.6.0",
			"onFail": "error"
		}
	}
}
